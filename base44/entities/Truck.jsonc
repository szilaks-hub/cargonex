{
  "name": "Truck",
  "type": "object",
  "properties": {
    "loading_date": {
      "type": "string",
      "format": "date"
    },
    "expected_loading_date": {
      "type": "string",
      "format": "date"
    },
    "actual_loading_date": {
      "type": "string",
      "format": "date"
    },
    "carrier_id": {
      "type": "string"
    },
    "carrier_name": {
      "type": "string"
    },
    "origin_site_id": {
      "type": "string"
    },
    "origin_location_name": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string",
      "description": "Denormalized from Orderbook for Finance/Customs"
    },
    "supplier_site_name": {
      "type": "string",
      "description": "Denormalized from Orderbook for Finance/Customs"
    },
    "origin_country": {
      "type": "string",
      "description": "Denormalized from PartnerLocation for Finance/Customs"
    },
    "product_id": {
      "type": "string",
      "description": "Primary product (legacy / single-product fallback)"
    },
    "product_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "description": "Multiple products on one truck",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "planned_quantity_tons": {
      "type": "number"
    },
    "actual_weight_tons": {
      "type": "number"
    },
    "loading_location_id": {
      "type": "string"
    },
    "loading_location_name": {
      "type": "string"
    },
    "destination_country": {
      "type": "string"
    },
    "destination_city": {
      "type": "string"
    },
    "destination_zip": {
      "type": "string"
    },
    "destination_county": {
      "type": "string"
    },
    "destination_region": {
      "type": "string"
    },
    "orderbook_id": {
      "type": "string",
      "description": "Reference to Orderbook"
    },
    "orderbook_no": {
      "type": "string",
      "description": "Denormalized Orderbook order_no"
    },
    "order_id": {
      "type": "string",
      "description": "Related purchase order (legacy)"
    },
    "order_number": {
      "type": "string"
    },
    "customs_agent_id": {
      "type": "string"
    },
    "customs_agent_name": {
      "type": "string"
    },
    "customs_agent_fee": {
      "type": "number"
    },
    "customs_agent_fee_currency": {
      "type": "string",
      "enum": [
        "EUR",
        "HUF"
      ],
      "default": "EUR",
      "description": "Currency of the customs agent fee (EUR or HUF)"
    },
    "purchase_price": {
      "type": "number"
    },
    "avg_price": {
      "type": "number"
    },
    "hs_code": {
      "type": "string"
    },
    "applied_freight_sheet_id": {
      "type": "string"
    },
    "applied_freight_sheet_line_id": {
      "type": "string"
    },
    "freight_domestic_leg_snapshot": {
      "type": "number"
    },
    "freight_foreign_leg_snapshot": {
      "type": "number"
    },
    "freight_total_snapshot": {
      "type": "number"
    },
    "freight_load_tons_snapshot": {
      "type": "number"
    },
    "freight_eur_per_ton_snapshot": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "booked",
        "loaded",
        "finance_control",
        "closed",
        "cancelled"
      ],
      "default": "booked"
    },
    "truck_number": {
      "type": "string"
    },
    "ekaer": {
      "type": "boolean",
      "default": false
    },
    "hs_code_verified": {
      "type": "boolean",
      "default": false
    },
    "invoice_checked": {
      "type": "boolean",
      "default": false
    },
    "checklist_notes": {
      "type": "string"
    },
    "supplier_invoice_number": {
      "type": "string",
      "description": "Elad\u00f3 sz\u00e1mlasz\u00e1ma"
    },
    "freight_invoice_number": {
      "type": "string"
    },
    "mrn_number": {
      "type": "string"
    },
    "mrn_date": {
      "type": "string",
      "format": "date",
      "description": "MRN d\u00e1tum"
    },
    "mrn_declared_amount": {
      "type": "number",
      "description": "MRN meg\u00e1llap\u00edtott \u00f6sszeg (HUF) \u2013 k\u00e9zi bevitel"
    },
    "declared_vat": {
      "type": "number"
    },
    "exchange_rate": {
      "type": "number"
    },
    "calculated_customs_value": {
      "type": "number"
    },
    "calculated_vat": {
      "type": "number"
    },
    "goods_value": {
      "type": "number"
    },
    "total_base": {
      "type": "number"
    },
    "amendment_requested": {
      "type": "boolean",
      "default": false,
      "description": "M\u00f3dos\u00edt\u00e1si k\u00e9relem beny\u00fajtva \u2013 2. MRN v\u00e1rhat\u00f3"
    },
    "amendment_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Amikor a m\u00f3dos\u00edt\u00e1si k\u00e9relem aktiv\u00e1lva lett"
    },
    "mrn_number_2": {
      "type": "string",
      "description": "2. (m\u00f3dos\u00edtott) MRN sz\u00e1m"
    },
    "mrn_date_2": {
      "type": "string",
      "format": "date",
      "description": "2. MRN d\u00e1tum"
    },
    "mrn_number_2_locked": {
      "type": "boolean",
      "default": false,
      "description": "Ha true, a 2. MRN sz\u00e1m \u00e9s d\u00e1tum nem m\u00f3dos\u00edthat\u00f3"
    },
    "closed_date": {
      "type": "string",
      "format": "date"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_by": {
      "type": "string"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_by": {
      "type": "string"
    },
    "lock_reason": {
      "type": "string"
    },
    "transit": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "loading_date",
    "carrier_id",
    "planned_quantity_tons",
    "destination_country"
  ]
}