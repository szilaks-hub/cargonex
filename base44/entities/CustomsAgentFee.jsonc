{
  "name": "CustomsAgentFee",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "Reference to Partner (customs agent)"
    },
    "partner_name": {
      "type": "string"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "fee_type": {
      "type": "string",
      "enum": [
        "fixed",
        "per_truck",
        "per_declaration"
      ],
      "default": "per_truck",
      "description": "Fee type / D\u00edj t\u00edpusa"
    },
    "fee_per_truck": {
      "type": "number",
      "description": "Fee amount"
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "HUF",
        "USD"
      ],
      "default": "EUR"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "partner_id",
    "period_from",
    "fee_per_truck"
  ]
}