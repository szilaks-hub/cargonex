{
  "name": "FreightSheetLine",
  "type": "object",
  "properties": {
    "sheet_id": {
      "type": "string",
      "description": "Reference to FreightSheet"
    },
    "destination_zip": {
      "type": "string",
      "description": "Destination ZIP code"
    },
    "destination_city": {
      "type": "string",
      "description": "Destination city"
    },
    "destination_county": {
      "type": "string",
      "description": "Destination county (HU only)"
    },
    "destination_region": {
      "type": "string",
      "description": "Destination region (non-HU)"
    },
    "domestic_leg": {
      "type": "number",
      "description": "Domestic leg price EUR"
    },
    "foreign_leg": {
      "type": "number",
      "description": "Foreign leg price EUR"
    },
    "total_price": {
      "type": "number",
      "description": "Auto = domestic + foreign"
    },
    "load_tons": {
      "type": "number",
      "description": "Load override (optional, falls back to sheet default)"
    },
    "eur_per_ton": {
      "type": "number",
      "description": "Auto = total / load_tons"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Active vagy Archived \u2013 t\u00f6rl\u00e9s nem lehets\u00e9ges"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_by": {
      "type": "string",
      "description": "User email who archived"
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "Accounting lock - no edits allowed"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_by": {
      "type": "string",
      "description": "User email who locked"
    },
    "lock_reason": {
      "type": "string",
      "description": "Reason for locking"
    }
  },
  "required": [
    "sheet_id",
    "destination_city",
    "domestic_leg",
    "foreign_leg"
  ]
}